:root{--bg:#09050f;--panel:#17101f;--panel2:#21142b;--gold:#ffd274;--red:#ff4f67;--text:#fff6ea;--muted:#c9bccd;--line:rgba(255,255,255,.13)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,sans-serif;background:radial-gradient(circle at 15% 10%,#32133f 0,transparent 28%),radial-gradient(circle at 85% 20%,#4a171f 0,transparent 26%),var(--bg);color:var(--text)}
a{text-decoration:none;color:inherit}button,input,select,textarea{font:inherit}
.hidden{display:none!important}.ticker{overflow:hidden;white-space:nowrap;background:linear-gradient(90deg,#8b101c,#c63228,#8b101c);padding:9px 0;font-weight:800}.ticker span{display:inline-block;padding-left:100%;animation:ticker 18s linear infinite}@keyframes ticker{to{transform:translateX(-100%)}}
.header{position:sticky;top:0;z-index:50;background:rgba(9,5,15,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:10px 14px;display:flex;align-items:center;justify-content:space-between}.icon{border:1px solid var(--line);background:#21142b;color:#fff;border-radius:12px;padding:10px 13px;font-weight:800}
.brand{text-align:center;padding:20px 12px 10px}.brand h1{margin:0;font-size:clamp(25px,6vw,48px);letter-spacing:1px;color:var(--gold);text-shadow:0 0 24px rgba(255,210,116,.25)}.tag{font-size:12px;color:#ffe3a6;margin-top:7px}.sub{font-size:14px;color:var(--muted);margin-top:8px}
.quick{display:flex;gap:8px;overflow:auto;padding:10px 12px 14px;justify-content:center}.quick button{white-space:nowrap;border:1px solid var(--line);background:linear-gradient(145deg,#251530,#15101c);color:#fff;border-radius:20px;padding:9px 13px;font-weight:700}
.hero{padding:0 12px}.slider{position:relative;min-height:280px;border-radius:22px;overflow:hidden;border:1px solid var(--line);box-shadow:0 20px 50px rgba(0,0,0,.4)}.slide{position:absolute;inset:0;display:none;align-items:center;padding:28px;background-size:cover}.slide.active{display:flex}.s1{background:linear-gradient(115deg,#24133b,#8a1c2b 58%,#32102d)}.s2{background:linear-gradient(115deg,#0e304b,#7d2140 58%,#2b0f36)}.s3{background:linear-gradient(115deg,#4a1717,#a15a19 58%,#31133b)}.s4{background:linear-gradient(115deg,#102c39,#5c207a 58%,#361226)}.s5{background:linear-gradient(115deg,#4c1620,#805c12 58%,#24102e)}.slide h2{font-size:clamp(30px,7vw,58px);margin:10px 0}.badge{display:inline-block;background:#ffd274;color:#2b1520;padding:6px 10px;border-radius:20px;font-size:11px;font-weight:900}.dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:7px}.dots button{width:9px;height:9px;border:0;border-radius:50%;background:#aaa}.dots button.active{background:var(--gold)}
main{max-width:1150px;margin:auto;padding:18px 12px 90px}.search{width:100%;padding:14px;border-radius:14px;border:1px solid var(--line);background:#17101f;color:#fff;margin:14px 0 18px}.sectionTitle{margin:24px 0 12px;color:var(--gold)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{background:linear-gradient(145deg,#22142c,#120d19);border:1px solid var(--line);border-radius:18px;padding:14px;box-shadow:0 10px 25px rgba(0,0,0,.25)}.card h3{margin:0 0 8px;font-size:16px}.price{color:var(--gold);font-weight:900;font-size:18px}.card p{margin:7px 0;color:var(--muted);font-size:13px}.add{width:100%;padding:10px;border:0;border-radius:11px;background:linear-gradient(90deg,#d69d34,#ffcf6b);color:#24140c;font-weight:900}
