{"cat":"BOMB","no":38,"name":"Digital Bomb","qty":"1 Box","rate":220},

{"cat":"ROCKETS","no":39,"name":"Rocket Bomb","qty":"1 Box","rate":100},
{"cat":"ROCKETS","no":40,"name":"Lunik Rocket","qty":"1 Box","rate":150},
{"cat":"ROCKETS","no":41,"name":"Musical Rocket","qty":"1 Box","rate":150},

{"cat":"PENCIL TORCHES","no":42,"name":"Fire Pencil","qty":"1 Box","rate":120},
{"cat":"PENCIL TORCHES","no":43,"name":"Flash Light","qty":"1 Box","rate":180},
{"cat":"PENCIL TORCHES","no":44,"name":"Water Pencil","qty":"1 Box","rate":190},
{"cat":"PENCIL TORCHES","no":45,"name":"3 Pcs Pencil","qty":"1 Box","rate":220},

{"cat":"PAPER BOMB","no":46,"name":"¼ Adiyal","qty":"1 Box","rate":35},
