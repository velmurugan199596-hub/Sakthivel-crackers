.bottom{position:fixed;bottom:0;left:0;right:0;z-index:55;background:#130c1b;border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:8px}.bottom button{background:none;border:0;color:#fff;font-weight:800}
