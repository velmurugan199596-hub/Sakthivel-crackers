],['50cm Colour','SPARKLERS',220],['30cm ELE','SPARKLERS',55],['30cm Colour','SPARKLERS',55],['30cm Red','SPARKLERS',60],['30cm Green','SPARKLERS',60],['15cm ELE','SPARKLERS',55],['15cm Colour','SPARKLERS',55],['15cm Red','SPARKLERS',60],['15cm Green','SPARKLERS',60],['10cm ELE','SPARKLERS',15],['10cm Colour','SPARKLERS',15],['10cm Red','SPARKLERS',20],['10cm Green','SPARKLERS',20],['7cm ELE','SPARKLERS',8],['7cm Colour','SPARKLERS',8],['7cm Red','SPARKLERS',10],['7cm Green','SPARKLERS',10],['25 Item Box','GIFT BOX',400],['30 Item Box','GIFT BOX',500],['36 Item Box','GIFT BOX',600],['41 Item Box','GIFT BOX',750],['50 Item Box','GIFT BOX',900],['60 Item Box','GIFT BOX',1000],['70 Item Box','GIFT BOX',1200]
].map((x,i)=>({id:i+1,name:x[0],category:x[1],price:x[2],enabled:true})),
cart:[],orders:[]
};
let stored=JSON.parse(localStorage.getItem(KEY)||'null');
let data=stored?{...defaultData,...stored,settings:{...defaultData.settings,...(stored.settings||{})},priceList:{...defaultData.priceList,...(stored.priceList||{})}}:defaultData;
// Stock migration: null means stock management has not been set yet; 0 explicitly means OUT OF STOCK.
(data.products||[]).forEach(p=>{if(typeof p.stock!=='number' || p.stock<0) p.stock=null;});
save();

// Catalogue migration: always restore the complete 130-item list while keeping any photos/prices
// the owner already saved for matching products.
if(!Array.isArray(data.products) || data.products.length<130){
  const oldByName=new Map((data.products||[]).map(p=>[p.name,p]));
  data.products=defaultData.products.map(p=>{
    const old=oldByName.get(p.name);
    return old?{...p,...old,category:p.category,price:old.price??p.price,enabled:old.enabled!==false,image:old.image||''}:{...p};
  });
  save();
}
function save(){localStorage.setItem(KEY,JSON.stringify(data))}
function go(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'});closePanels()}
function applySettings(){let s=data.settings;[['ticker','ticker'],['quick','quickNav'],['hero','hero'],['search','search'],['categories','categories'],['products','products'],['cart','cartPanel'],['whatsapp','whatsappFab'],['top','topBtn'],['bottom','bottomBar'],['support','support'],['priceList','priceListSection']].forEach(([k,id])=>document.getElementById(id)?.classList.toggle('hidden',!s[k]));document.getElementById('brandName').textContent=data.brand;document.getElementById('miniBrand').textContent=data.brand;document.getElementById('footerBrand').textContent=data.brand;document.getElementById('tagline').textContent=data.tagline;document.getElementById('addressLine').textContent=data.address;document.getElementById('year').textContent=new Date().getFullYear()}
function renderSlider(){let el=document.getElementById('slider');el.innerHTML=data.banners.map((b,i)=>`<div class="slide ${b[3]} ${i==0?'active':''}"><div><span class="badge">${b[0]}</span><h2>${b[1]}</h2><p>${b[2]}</p><button class="save" onclick="go('products')">SHOP NOW →</button></div></div>`).join('')+'<div class="dots">'+data.banners.map((_,i)=>`<button class="${i==0?'active':''}" onclick="showSlide(${i})"></button>`).join('')+'</div>';showSlide(0)}
let slide=0,slideTimer;function showSlide(i){let a=[...document.querySelectorAll('.slide')],d=[...document.querySelectorAll('.dots button')];if(!a.length)return;slide=(i+a.length)%a.length;a.forEach((x,n)=>x.classList.toggle('active',n==slide));d.forEach((x,n)=>x.classList.toggle('active',n==slide));clearInterval(slideTimer);slideTimer=setInterval(()=>showSlide(slide+1),4000)}
function renderCats(){document.getElementById('catGrid').innerHTML=data.categories.map(c=>`<button class="cat" onclick="document.getElementById('search').value='${c}';renderProducts();go('products')">${c}</button>`).join('')}
function productPhoto(x){
  if(x.image) return `<img src="${x.image}" alt="${x.name}" data-product-id="${x.id}" style="width:100%;height:150px;object-fit:contain;border-radius:12px;background:#fff">`;
  const icons={'ONE SOUND CRACKERS':'💥','FLOWER POTS':'🌸','GROUND CHAKKAR':'🌀','BIJILI PATTAS':'✨','MULTI SOUND':'🎇','TWINKLING STAR':'⭐','BOMB':'💣','ROCKETS':'🚀','PENCIL TORCHES':'🔦','PAPER BOMB':'🧨','NEW FANCY ITEMS':'🎉','FANCY ITEMS':'🎆','MULTI SHOT FANCY':'🎆','SINGLE SHOT FANCY':'🎇','SPARKLERS':'✨','GIFT BOX':'🎁'};
  return `<div style="height:150px;border-radius:12px;background:linear-gradient(135deg,#21142b,#4b173f);display:flex;align-items:center;justify-content:center;flex-direction:column;color:#ffd274"><span style="font-size:52px">${icons[x.category]||'🎆'}</span><small style="color:#fff;opacity:.8">Product Photo</small></div>`;
}
function renderProducts(){let q=(document.getElementById('search').value||'').toLowerCase();let p=data.products.filter(x=>x.enabled&&(x.name.toLowerCase().includes(q)||x.category.toLowerCase().includes(q)));document.getElementById('productCount').textContent=' • '+p.length+' products';document.getElementById('productGrid').innerHTML=p.map(x=>`<div class="card">${productPhoto(x)}<h3>${x.name}</h3><p>${x.category}</p><div class="price">₹${x.price}</div><button class="add" onclick="addCart(${x.id})">ADD TO CART</button></div>`).join('')||'<p>No products found.</p>'}
function renderSupport(){document.getElementById('supportLinks').innerHTML=`<a href="tel:${data.phone.replace(/\s/g,'')}">📞 Call: ${data.phone}</a><a href="https://wa.me/91${data.phone.replace(/\D/g,'')}" target="_blank">💬 WhatsApp Support</a><a href="mailto:${data.email}">📧 ${data.email}</a>`}
function addCart(id){let x=data.products.find(p=>p.id==id);let c=data.cart.find(c=>c.id==id);if(c)c.qty++;else data.cart.push({id:x.id,name:x.name,price:x.price,qty:1});save();renderCart()}
function renderCart(){let total=data.cart.reduce((a,x)=>a+x.price*x.qty,0);document.getElementById('cartCount').textContent=data.cart.reduce((a,x)=>a+x.qty,0);document.getElementById('cartTotal').textContent=total;document.getElementById('cartItems').innerHTML=data.cart.map(x=>`<div class="adminItem cartItem"><button class="removeCart" aria-label="Remove ${x.name}" title="Remove product" onclick="removeFromCart(${x.id})">✕</button><b class="cartProductName">${x.name}</b><div class="cartLine"><strong>₹${x.price}</strong> × <strong>${x.qty}</strong></div><div class="row cartQty"><button class="small" onclick="qty(${x.id},1)">+</button><button class="small" onclick="qty(${x.id},-1)">−</button></div></div>`).join('')||'<p>Your cart is empty.</p>'}
function qty(id,n){let c=data.cart.find(x=>x.id==id);if(!c)return;c.qty+=n;if(c.qty<=0)data.cart=data.cart.filter(x=>x.id!=id);save();renderCart()}
function removeFromCart(id){data.cart=data.cart.filter(x=>x.id!=id);save();renderCart()}
function openMenu(){document.getElementById('drawer').classList.add('open');document.getElementById('overlay').classList.add('show')}function openCart(){document.getElementById('cartPanel').classList.add('open');document.getElementById('overlay').classList.add('show');renderCart()}function closePanels(){document.getElementById('drawer').classList.remove('open');document.getElementById('cartPanel').classList.remove('open');document.getElementById('overlay').classList.remove('show')}
function modal(html){document.getElementById('modalBox').innerHTML=html;document.getElementById('modal').classList.add('show')}function closeModal(){
  if(adminLoggedIn){return;}
  document.getElementById('modal').classList.remove('show')
}
document.getElementById('modal').addEventListener('click',function(e){
  if(adminLoggedIn && e.target===this) e.stopPropagation();
});

// Price List PDF support: admin can upload a PDF for this browser, or publish a public PDF URL for all visitors.
const PDF_DB='sakthivelPriceListDB';
function openPdfDB(){return new Promise((resolve,reject)=>{const r=indexedDB.open(PDF_DB,1);r.onupgradeneeded=()=>r.result.createObjectStore('files');r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}
async function saveLocalPDF(file){const db=await openPdfDB();return new Promise((resolve,reject)=>{const tx=db.transaction('files','readwrite');tx.objectStore('files').put(file,'priceList');tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}
async function getLocalPDF(){const db=await openPdfDB();return new Promise((resolve,reject)=>{const tx=db.transaction('files','readonly');const r=tx.objectStore('files').get('priceList');r.onsuccess=()=>resolve(r.result||null);r.onerror=()=>reject(r.error)})}
async function viewPriceList(){
  if(data.priceList?.url){window.open(data.priceList.url,'_blank');return}
  try{const file=await getLocalPDF();if(file){const url=URL.createObjectURL(file);window.open(url,'_blank');return}}catch(e){}
  modal(`<button class="small close" onclick="closeModal()">✕</button><div class="pdfBox"><h2>📄 Price List</h2><p>Price List PDF இன்னும் upload செய்யப்படவில்லை.</p><p>Admin Panel → Price List PDF பகுதியில் PDF upload செய்யுங்கள்.</p></div>`)
}
function adminPriceList(){
  document.getElementById('adminContent').innerHTML=`<h3>📄 Price List PDF</h3>
  <div class="adminItem"><b>Customer View</b><p>Customer website-ல் “View Price List” button மூலம் PDF திறக்கும்.</p></div>
  <div class="adminItem"><b>1. Public PDF URL (அனைத்து customers-க்கும்)</b><input id="plUrl" value="${data.priceList?.url||''}" placeholder="https://your-site.com/price-list.pdf"><input id="plNote" value="${data.priceList?.note||''}" placeholder="Price List note"><button class="save" onclick="savePriceListUrl()">Save & Publish URL</button></div>
  <div class="adminItem"><b>2. Upload PDF (இந்த device/browser-ல் உடனடி preview)</b><input id="plFile" type="file" accept="application/pdf"><button class="save" onclick="uploadPriceList()">Upload PDF</button><p id="plStatus">${data.priceList?.name||'No PDF uploaded'}</p></div>
  <div class="adminItem"><small>குறிப்பு: static free hosting-ல் browser-லிருந்து upload செய்த PDF மற்ற customers-க்கு தானாக பகிரப்படாது. எல்லோருக்கும் காட்ட Public PDF URL பயன்படுத்தலாம்; cloud upload வேண்டுமெனில் பின்னர் Supabase/Firebase Storage இணைக்கலாம்.</small></div>`
}
function savePriceListUrl(){data.priceList=data.priceList||{};data.priceList.url=document.getElementById('plUrl').value.trim();data.priceList.note=document.getElementById('plNote').value.trim();save();document.getElementById('priceListNote').textContent=data.priceList.note||'எங்கள் தற்போதைய Price List PDF-ஐ இங்கே பார்க்கலாம்.';alert('Price List URL saved');adminPriceList()}
async function uploadPriceList(){const f=document.getElementById('plFile').files[0];if(!f||f.type!=='application/pdf')return alert('PDF file மட்டும் தேர்வு செய்யுங்கள்');await saveLocalPDF(f);data.priceList=data.priceList||{};data.priceList.name=f.name;save();alert('PDF uploaded successfully');adminPriceList()}

function createBill(){
  if(!data.cart.length)return alert('Cart is empty');
  modal(`<button class="small close" onclick="closeModal()">✕</button><h2>🧾 Customer Details</h2><input id="custName" placeholder="Customer Name"><input id="custPhone" placeholder="Mobile Number"><textarea id="custAddress" placeholder="Delivery Address"></textarea><button class="save" onclick="confirmBill()">Generate Bill & Continue</button>`)
}
function confirmBill(){
  const name=(document.getElementById('custName').value||'').trim();
  const phone=(document.getElementById('custPhone').value||'').trim();
  const address=(document.getElementById('custAddress').value||'').trim();
  if(!name||!phone||!address)return alert('Name, Mobile Number, Address அனைத்தையும் நிரப்புங்கள்');
  let total=data.cart.reduce((a,x)=>a+x.price*x.qty,0);let id='SK'+Date.now().toString().slice(-6);
  const items=[...data.cart];
  data.orders.push({id,date:new Date().toLocaleString('en-IN'),customer:name,phone,address,items,total,status:'PENDING'});save();
  const rows=items.map(x=>`<div class="adminItem"><b>${x.name}</b><br>${x.qty} × ₹${x.price} = <b>₹${x.qty*x.price}</b></div>`).join('');
  // எல்லா orders-க்கும் ஒரே business WhatsApp number.
  const businessWhatsApp='919344265054';
  const message=[
    `🎆 ${data.brand} – NEW ORDER`,
    `━━━━━━━━━━━━━━━━`,
    `🧾 Order No: ${id}`,
    `👤 Customer: ${name}`,
    `📞 Mobile: ${phone}`,
    `📍 Address: ${address}`,
    ``,
    `🛍️ ORDER DETAILS`,
    ...items.map(x=>`${x.name} × ${x.qty} = ₹${x.qty*x.price}`),
    ``,
    `💰 TOTAL: ₹${total}`,
    `━━━━━━━━━━━━━━━━`,
    `Please confirm my order.`
  ].join('\n');
  const whatsappUrl=`https://wa.me/${businessWhatsApp}?text=${encodeURIComponent(message)}`;
  modal(`<button class="small close" onclick="closeModal()">✕</button><div style="background:linear-gradient(135deg,#7b1420,#d78d2f,#35113c);padding:20px;border-radius:14px;color:#fff"><div style="font-size:12px;opacity:.9">🎆 ORDER INVOICE</div><h1 style="margin:5px 0">${data.brand}</h1><b>Order No: ${id}</b><p>Customer: ${name}<br>📞 ${phone}<br>📍 ${address}</p></div><h3 style="color:var(--gold)">ORDER DETAILS</h3>${rows}<div style="padding:15px;border-radius:12px;background:#24142d;margin-top:12px"><h2 style="margin:0">TOTAL: ₹${total}</h2><b style="color:#7ff0a5">ORDER RECEIVED</b></div><div class="row" style="margin-top:14px"><button class="save" onclick="location.href='${whatsappUrl}'">💬 Send Order on WhatsApp</button><button class="small" onclick="window.print()">🖨️ Print / Save PDF</button></div><p style="color:var(--muted);font-size:12px">இந்த Order உங்கள் SAKTHIVEL CRACKERS WhatsApp எண்ணுக்கே அனுப்பப்படும்.</p>`);
  data.cart=[];save();renderCart();
}
function adminLogin(){modal(`<button class="small close" onclick="closeModal()">✕</button><h2>🔐 Admin Login</h2><input id="au" placeholder="Username"><input id="ap" type="password" placeholder="Password"><button class="save" onclick="checkAdmin()">Login</button>`)}
function checkAdmin(){if(document.getElementById('au').value==='Amalaamala'&&document.getElementById('ap').value==='Velmurugan@1995'){adminPanel()}else alert('Invalid username or password')}
let adminLoggedIn=false;
function adminPanel(){
  adminLoggedIn=true;
  modal(`<div id="adminShell"><div class="row" style="justify-content:space-between;align-items:center"><h2 style="margin:0">⚙️ FULL ADMIN CONTROL</h2><button class="small danger" onclick="adminLogout()">🚪 LOGOUT</button></div><div class="adminTabs"><button onclick="adminSettings()">ON/OFF</button><button onclick="adminBanners()">Banners</button><button onclick="adminProducts()">Products</button><button onclick="adminCategories()">Categories</button><button onclick="adminBrand()">Brand/Support</button><button onclick="adminPriceList()">Price List PDF</button><button onclick="adminOrders()">Orders/Bills</button></div><div id="adminContent"></div></div>`);
  adminSettings();
}
function adminLogout(){
  adminLoggedIn=false;
  closeModal();
  window.scrollTo({top:0,behavior:'smooth'});
}
function adminSettings(){let el=document.getElementById('adminContent');el.innerHTML='<h3>Customer Website Feature ON / OFF</h3>'+Object.keys(data.settings).map(k=>`<div class="adminItem"><b>${k.toUpperCase()}</b><button class="small ${data.settings[k]?'on':'off'}" onclick="toggleSetting('${k}')">${data.settings[k]?'ON':'OFF'}</button></div>`).join('')}
function toggleSetting(k){data.settings[k]=!data.settings[k];save();applySettings();adminSettings()}
function adminBanners(){document.getElementById('adminContent').innerHTML=`<h3>Slider Banners</h3>${data.banners.map((b,i)=>`<div class="adminItem"><b>${b[1]}</b><div class="row"><button class="small" onclick="editBanner(${i})">Edit</button><button class="small danger" onclick="deleteBanner(${i})">Delete</button></div></div>`).join('')}<button class="save" onclick="editBanner(-1)">+ Add Banner</button>`}
function editBanner(i){let b=i>=0?data.banners[i]:['','','','s1'];modal(`<h2>${i>=0?'Edit':'Add'} Banner</h2><input id="b0" value="${b[0]}" placeholder="Small badge"><input id="b1" value="${b[1]}" placeholder="Main heading"><textarea id="b2" placeholder="Description">${b[2]}</textarea><select id="b3">${['s1','s2','s3','s4','s5'].map(x=>`<option ${x==b[3]?'selected':''}>${x}</option>`).join('')}</select><button class="save" onclick="saveBanner(${i})">Save Banner</button>`)}
function saveBanner(i){let b=['b0','b1','b2','b3'].map(id=>document.getElementById(id).value);if(i>=0)data.banners[i]=b;else data.banners.push(b);save();renderSlider();adminPanel()}
function deleteBanner(i){if(confirm('Delete banner?')){data.banners.splice(i,1);save();renderSlider();adminBanners()}}
function orderQtyForProduct(pid){
  return (data.orders||[]).filter(o=>o.status!=='REJECTED').reduce((sum,o)=>
    sum+(o.items||[]).filter(it=>String(it.id)===String(pid)).reduce((a,it)=>a+Number(it.qty||0),0),0);
}
function adminProducts(){
  document.getElementById('adminContent').innerHTML=`<h3>Products & Stock</h3>
  <div class="adminItem"><b>Stock meaning:</b> Initial Stock → Ordered → Remaining. Set Stock to <b>0</b> to automatically show <b>OUT OF STOCK</b> to customers.</div>
  <button class="save" onclick="editProduct(-1)">+ Add Product</button>
  ${data.products.map((p,i)=>{
    const ordered=orderQtyForProduct(p.id);
    const stock=typeof p.stock==='number'?p.stock:null;
    const remaining=stock===null?null:Math.max(0,stock-ordered);
    return `<div class="adminItem"><b>${p.name}</b><br>₹${p.price} • ${p.category}
      <div style="margin-top:7px;font-weight:800">📦 Stock: ${stock===null?'Not Set':stock} &nbsp;|&nbsp; 🛒 Ordered: ${ordered} &nbsp;|&nbsp; 📊 Remaining: ${remaining===null?'—':remaining}</div>
      <div class="row"><button class="small" onclick="editProduct(${i})">Edit</button><button class="small ${p.enabled?'on':'off'}" onclick="toggleProduct(${i})">${p.enabled?'ON':'OFF'}</button><button class="small danger" onclick="deleteProduct(${i})">Delete</button></div>
    </div>`;
  }).join('')}`;
}
function editProduct(i){let p=i>=0?data.products[i]:{name:'',category:data.categories[0]||'',price:0,enabled:true,image:''};modal(`<h2>${i>=0?'Edit':'Add'} Product</h2><input id="pn" value="${p.name}" placeholder="Product name"><select id="pc">${data.categories.map(c=>`<option ${c==p.category?'selected':''}>${c}</option>`).join('')}</select><input id="pp" type="number" value="${p.price}" placeholder="Price"><p style="color:#c9bccd">🖼️ Product Photo ${p.image?'(current photo will stay unless you choose a new one)':''}</p><input id="pi" type="file" accept="image/*"><button class="save" onclick="saveProduct(${i})">Save Product</button>`)}
function saveProduct(i){let old=i>=0?data.products[i]:null;let p={id:old?old.id:Date.now(),name:document.getElementById('pn').value.trim(),category:document.getElementById('pc').value,price:Number(document.getElementById('pp').value),enabled:old?old.enabled:true,image:old?.image||''};if(!p.name||!p.price)return alert('Product name மற்றும் price கொடுக்கவும்');let f=document.getElementById('pi').files[0];const finish=()=>{if(i>=0)data.products[i]=p;else data.products.push(p);save();renderProducts();adminPanel()};if(f){let r=new FileReader();r.onload=()=>{p.image=r.result;finish()};r.readAsDataURL(f)}else finish()}
function toggleProduct(i){data.products[i].enabled=!data.products[i].enabled;save();renderProducts();adminProducts()}function deleteProduct(i){if(confirm('Delete product?')){data.products.splice(i,1);save();renderProducts();adminProducts()}}
function adminCategories(){document.getElementById('adminContent').innerHTML=`<h3>Categories</h3><input id="newCat" placeholder="New category"><button class="save" onclick="addCategory()">Add Category</button>${data.categories.map((c,i)=>`<div class="adminItem"><b>${c}</b><button class="small danger" onclick="deleteCategory(${i})">Delete</button></div>`).join('')}`}
function addCategory(){let c=document.getElementById('newCat').value.trim();if(c&&!data.categories.includes(c)){data.categories.push(c);save();renderCats();adminCategories()}}function deleteCategory(i){if(confirm('Delete category?')){data.categories.splice(i,1);save();renderCats();adminCategories()}}
function adminBrand(){document.getElementById('adminContent').innerHTML=`<h3>Brand & Customer Support</h3><input id="br" value="${data.brand}" placeholder="Brand name"><input id="tg" value="${data.tagline}" placeholder="Tagline"><input id="ad" value="${data.address}" placeholder="Address"><input id="ph" value="${data.phone}" placeholder="Phone"><input id="em" value="${data.email}" placeholder="Email"><button class="save" onclick="saveBrand()">Save Changes</button>`}
function saveBrand(){data.brand=document.getElementById('br').value;data.tagline=document.getElementById('tg').value;data.address=document.getElementById('ad').value;data.phone=document.getElementById('ph').value;data.email=document.getElementById('em').value;save();applySettings();renderSupport();adminPanel()}
function adminOrders(){
  const all=Array.isArray(data.orders)?data.orders:[];
  const status=o=>String(o.status||'PENDING').toUpperCase();
  const pending=all.filter(o=>!['CONFIRMED','REJECTED'].includes(status(o)));
  const confirmed=all.filter(o=>status(o)==='CONFIRMED');
  const rejected=all.filter(o=>status(o)==='REJECTED');
  const sortNew=(a,b)=>String(b.id).localeCompare(String(a.id),undefined,{numeric:true});

  const card=o=>{
    const id=JSON.stringify(String(o.id));
    const items=(o.items||[]).map(x=>`<div>${x.name} × ${x.qty} = ₹${Number(x.price||0)*Number(x.qty||0)}</div>`).join('');
    const buttons=status(o)==='CONFIRMED'
      ? `<button class="small on" onclick='downloadBillPDF(${JSON.stringify(o)})'>⬇️ DOWNLOAD BILL</button>`
      : status(o)==='REJECTED'
        ? `<button class="small" onclick='downloadBillPDF(${JSON.stringify(o)})'>⬇️ DOWNLOAD BILL</button>`
        : `<button class="small on" onclick='confirmOrder(${id})'>✅ CONFIRM ORDER</button>
           <button class="small danger" onclick='rejectOrder(${id})'>❌ REJECT ORDER</button>`;
    return `<div class="adminItem">
      <b>🧾 ${o.id}</b><br>${o.date||''}<br>
      👤 ${o.customer||''} • 📞 ${o.phone||''}<br>
      📍 ${o.address||''}<br>
      <b>Total ₹${o.total||0}</b><br>
      <b>Status: ${o.status||'PENDING'}</b>
      <details style="margin-top:8px"><summary>View Bill / Items</summary>${items}<hr><b>Total ₹${o.total||0}</b></details>
      <div class="row" style="margin-top:10px">${buttons}</div>
    </div>`;
  };

  document.getElementById('adminContent').innerHTML=`<h3>Orders / Bills</h3>
    <div class="adminItem" style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="small" onclick="showOrderGroup('pending')">🟠 Pending Orders (${pending.length})</button>
      <button class="small on" onclick="showOrderGroup('confirmed')">🟢 Confirmed Orders (${confirmed.length})</button>
      <button class="small danger" onclick="showOrderGroup('rejected')">🔴 Rejected Orders (${rejected.length})</button>
    </div>
    <div id="orderGroupContent"></div>`;

  window._orderGroups={pending,confirmed,rejected,sortNew,card};
  showOrderGroup('pending');
}

window.showOrderGroup=function(group){
  const g=window._orderGroups||{};
  const list=[...(g[group]||[])].sort(g.sortNew||(()=>0));
  const titles={pending:'🟠 PENDING ORDERS',confirmed:'🟢 CONFIRMED ORDERS',rejected:'🔴 REJECTED ORDERS'};
  const colors={pending:'#ffcf6b',confirmed:'#7ff0a5',rejected:'#ff6577'};
  const el=document.getElementById('orderGroupContent');
  if(el) el.innerHTML=`<h4 style="color:${colors[group]||'#fff'}">${titles[group]||'ORDERS'} (${list.length})</h4>${list.length?list.map(g.card).join(''):'<p>No orders.</p>'}`;
}

window.confirmOrder=function(id){
  const o=(data.orders||[]).find(x=>String(x.id)===String(id));
  if(!o){alert('Order not found');return;}
  if(String(o.status||'PENDING').toUpperCase()==='CONFIRMED'){
    adminOrders();
    return;
  }
  // Deduct exactly the quantities in this order, once, when admin confirms it.
  (o.items||[]).forEach(item=>{
    const p=(data.products||[]).find(x=>String(x.id)===String(item.productId||item.id)||String(x.name||'').trim()===String(item.name||'').trim());
    if(p){
      const qty=Math.max(0,Number(item.qty)||0);
      const current=Math.max(0,Number(p.stock)||0);
      p.stock=Math.max(0,current-qty);
    }
  });
  o.status='CONFIRMED';
  o.confirmedAt=new Date().toLocaleString('en-IN');
  save();
  adminOrders();
  renderProducts();
  toast('✅ Order confirmed. Stock updated. Download Bill is ready.',true);
}

window.rejectOrder=function(id){
  const o=(data.orders||[]).find(x=>String(x.id)===String(id));
  if(!o){alert('Order not found');return;}
  if(confirm('Reject this order?')){
    o.status='REJECTED';
    o.rejectedAt=new Date().toLocaleString('en-IN');
    save();
    adminOrders();
    renderProducts();
    toast('❌ Order rejected',true);
  }
}

applySettings();document.getElementById('priceListNote').textContent=data.priceList?.note||'எங்கள் தற்போதைய Price List PDF-ஐ இங்கே பார்க்கலாம்.';renderSlider();renderCats();renderProducts();renderSupport();renderCart();
</script>
<script id="sakthivel-photo-upload-fix">
(function(){
  const DB_NAME="sakthivelProductPhotosDB";
  const urls={}; window.__sakthivelPhotoUrls=urls;

  function db(){
    return new Promise((resolve,reject)=>{
      const r=indexedDB.open(DB_NAME,1);
      r.onupgradeneeded=()=>r.result.createObjectStore("photos");
      r.onsuccess=()=>resolve(r.result);
      r.onerror=()=>reject(r.error);
    });
  }
  async function put(id,file){
    const d=await db();
    return new Promise((resolve,reject)=>{
      const tx=d.transaction("photos","readwrite");
      tx.objectStore("photos").put(file,String(id));
      tx.oncomplete=resolve; tx.onerror=()=>reject(tx.error);
    });
  }
  async function get(id){
    const d=await db();
    return new Promise((resolve,reject)=>{
      const r=d.transaction("photos","readonly").objectStore("photos").get(String(id));
      r.onsuccess=()=>resolve(r.result||null); r.onerror=()=>reject(r.error);
    });
  }
  async function del(id){
    try{
      const d=await db();
      await new Promise((resolve,reject)=>{
        const tx=d.transaction("photos","readwrite");
        tx.objectStore("photos").delete(String(id));
        tx.oncomplete=resolve; tx.onerror=()=>reject(tx.error);
      });
    }catch(e){}
  }
  function resize(file){
    return new Promise((resolve,reject)=>{
      if(!file || !file.type.startsWith("image/")) return reject(new Error("Image file மட்டும் தேர்வு செய்யுங்கள்"));
      const im=new Image(), u=URL.createObjectURL(file);
      im.onload=()=>{
        URL.revokeObjectURL(u);
        const max=1200;
        let w=im.naturalWidth,h=im.naturalHeight;
        if(w>max||h>max){const s=Math.min(max/w,max/h);w=Math.round(w*s);h=Math.round(h*s);}
        const c=document.createElement("canvas"); c.width=w;c.height=h;
        c.getContext("2d").drawImage(im,0,0,w,h);
        c.toBlob(b=>b?resolve(new File([b],"product.webp",{type:"image/webp"})):reject(new Error("Image conversion failed")),"image/webp",.82);
      };
      im.onerror=()=>{URL.revokeObjectURL(u);reject(new Error("Photo-வை படிக்க முடியவில்லை"));};
      im.src=u;
    });
  }
  function toast(msg,good=true){
    let t=document.getElementById("photoToast");
    if(!t){t=document.createElement("div");t.id="photoToast";t.style.cssText="position:fixed;left:50%;bottom:90px;transform:translateX(-50%);z-index:999999;padding:12px 18px;border-radius:999px;color:#fff;font-weight:700;box-shadow:0 8px 25px #0005";document.body.appendChild(t);}
    t.textContent=msg;t.style.background=good?"#138a4b":"#a32232";
    clearTimeout(t.timer);t.timer=setTimeout(()=>t.remove(),2500);
  }

  function photo(p){
    if(urls[p.id]) return `<img src="${urls[p.id]}" alt="${p.name}" style="width:100%;height:150px;object-fit:contain;border-radius:12px;background:#fff">`;
    if(p.image && p.image.startsWith("data:image")) return `<img src="${p.image}" alt="${p.name}" style="width:100%;height:150px;object-fit:contain;border-radius:12px;background:#fff">`;
    return `<div style="height:150px;border-radius:12px;background:linear-gradient(135deg,#21142b,#4b173f);display:flex;align-items:center;justify-content:center;font-size:52px">🎆</div>`;
  }

  window.renderProducts=function(){
    const q=(document.getElementById("search").value||"").toLowerCase();
    const p=data.products.filter(x=>x.enabled&&(x.name.toLowerCase().includes(q)||x.category.toLowerCase().includes(q)));
    const count=document.getElementById("productCount"); if(count) count.textContent=" • "+p.length+" products";
    document.getElementById("productGrid").innerHTML=p.map(x=>`<div class="card">${photo(x)}<h3>${x.name}</h3><p>${x.category}</p><div class="price">₹${x.price}</div><button class="add" onclick="addCart(${x.id})">ADD TO CART</button></div>`).join("")||"<p>No products found.</p>";
  };

  window.editProduct=function(i){
    const p=i>=0?data.products[i]:{name:"",category:data.categories[0]||"",price:0,enabled:true,image:"",stock:null};
    modal(`<button class="small close" onclick="closeModal()">✕</button>
    <h2>${i>=0?"Edit":"Add"} Product</h2>
    <input id="pn" value="${String(p.name).replace(/"/g,'&quot;')}" placeholder="Product name">
    <select id="pc">${data.categories.filter(c=>String(c).toUpperCase()!=="ALL").map(c=>`<option ${c===p.category?"selected":""}>${c}</option>`).join("")}</select>
    <input id="pp" type="number" value="${p.price||0}" placeholder="Price">
    <input id="ps" type="number" min="0" value="${typeof p.stock==='number'?p.stock:''}" placeholder="Stock quantity (leave blank = not set)">
    <div style="margin:12px 0;padding:12px;border:1px dashed #80678e;border-radius:12px">
      <b>🖼️ Product Photo</b>
      <div id="photoPreview" style="margin:10px 0">${urls[p.id]?`<img src="${urls[p.id]}" style="max-width:180px;max-height:130px;border-radius:10px">`:"No photo uploaded yet"}</div>
      <input id="pi" type="file" accept="image/*" onchange="previewProductPhoto(this)">
      <small>Photo தேர்வு செய்ததும் optimize செய்து save செய்யப்படும்.</small>
    </div>
    <button id="productSave" class="save" onclick="saveProduct(${i})">💾 Save Product</button>`);
  };

  window.previewProductPhoto=function(input){
    const f=input.files&&input.files[0]; if(!f)return;
    const u=URL.createObjectURL(f);
    document.getElementById("photoPreview").innerHTML=`<img src="${u}" style="max-width:180px;max-height:130px;border-radius:10px">`;
  };

  window.saveProduct=async function(i){
    const btn=document.getElementById("productSave");
    if(btn){btn.disabled=true;btn.textContent="⏳ Saving...";}
    try{
      const old=i>=0?data.products[i]:null;
      const stockRaw=document.getElementById("ps").value.trim();
      const stock=stockRaw===''?null:Math.max(0,Math.floor(Number(stockRaw)));
      const p={id:old?old.id:Date.now(),name:document.getElementById("pn").value.trim(),category:document.getElementById("pc").value,price:Number(document.getElementById("pp").value),enabled:old?old.enabled:true,image:old?.image||"",stock};
      if(!p.name||!(p.price>0)) throw new Error("Product name மற்றும் price கொடுக்கவும்");
      const file=document.getElementById("pi").files[0];
      if(file){
        const optimized=await resize(file);
        await put(p.id,optimized);
        if(urls[p.id]) URL.revokeObjectURL(urls[p.id]);
        urls[p.id]=URL.createObjectURL(optimized);
        p.image="indexeddb:"+p.id;
      }
      if(i>=0) data.products[i]=p; else data.products.push(p);
      save(); renderProducts(); closeModal(); adminPanel(); toast("✅ Product details saved",true);
    }catch(e){
      if(btn){btn.disabled=false;btn.textContent="💾 Save Product";}
      toast("❌ "+(e.message||"Save failed"),false);
    }
  };

  window.deleteProduct=async function(i){
    const p=data.products[i];
    if(confirm("Delete product?")){
      await del(p.id);
      if(urls[p.id]) URL.revokeObjectURL(urls[p.id]);
      data.products.splice(i,1); save(); renderProducts(); adminProducts();
    }
  };

  (async function load(){
    for(const p of data.products||[]){
      try{
        const b=await get(p.id);
        if(b){urls[p.id]=URL.createObjectURL(b);p.image="indexeddb:"+p.id;}
      }catch(e){}
    }
    renderProducts();
  })();
})();
</script>
<script id="sakthivel-premium-order-fix">
(function(){
  // Robust cart: never silently fails and gives immediate visual feedback.
  window.addCart=function(id){
    const x=data.products.find(p=>String(p.id)===String(id));
    if(!x){alert('இந்த product கிடைக்கவில்லை. Admin → Products-ல் சரிபார்க்கவும்.');return;}
    let c=data.cart.find(p=>String(p.id)===String(id));
    const current=c?Number(c.qty||0):0;
    if(c)c.qty=current+1;
    else data.cart.push({id:x.id,name:x.name,price:Number(x.price)||0,qty:1});
    save(); renderCart();
    const el=document.getElementById('cartCount');
    if(el){el.animate([{transform:'scale(1)'},{transform:'scale(1.35)'},{transform:'scale(1)'}],{duration:350});}
  };

  // Reliable category management with validation, duplicate protection and visible confirmation.
  window.addCategory=function(){
    const input=document.getElementById('newCat');
    const c=(input?.value||'').trim().replace(/\s+/g,' ');
    if(!c){alert('Category பெயரை உள்ளிடுங்கள்.');input?.focus();return;}
    const exists=data.categories.some(x=>x.trim().toLowerCase()===c.toLowerCase());
    if(exists){alert('இந்த Category ஏற்கனவே உள்ளது.');input?.focus();return;}
    data.categories.push(c);save();renderCats();
    const el=document.getElementById('adminContent');
    if(el)adminCategories();
    toast('✅ Category saved: '+c,true);
  };
  window.deleteCategory=function(i){
    const c=data.categories[i];
    if(!c)return;
    const used=data.products.filter(p=>p.category===c).length;
    if(used){alert('இந்த category-ல் '+used+' products உள்ளன. முதலில் products-ஐ வேறு category-க்கு மாற்றுங்கள்.');return;}
    if(confirm('Delete category: '+c+' ?')){data.categories.splice(i,1);save();renderCats();adminCategories();toast('🗑️ Category deleted',true)}
  };

  function toast(msg,good){
    let t=document.getElementById('skFinalToast');
    if(!t){t=document.createElement('div');t.id='skFinalToast';t.style.cssText='position:fixed;left:50%;bottom:90px;transform:translateX(-50%);z-index:999999;padding:12px 18px;border-radius:999px;color:#fff;font-weight:800;box-shadow:0 10px 30px #0008;max-width:90vw;text-align:center';document.body.appendChild(t)}
    t.textContent=msg;t.style.background=good?'#14864a':'#9b2534';clearTimeout(t._t);t._t=setTimeout(()=>t.remove(),2400);
  }

  function pdfEsc(s){return String(s).replace(/[^\x20-\x7E]/g,' ').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)')}
  function money(n){return 'Rs. '+Number(n||0).toLocaleString('en-IN')}
  function makeBillPDF(order){
    const W=595,H=842; let cmds=[];
    const fill=(r,g,b)=>cmds.push(`${r} ${g} ${b} rg`);
    const rect=(x,y,w,h,fillIt=true)=>cmds.push(`${x} ${y} ${w} ${h} re ${fillIt?'f':'S'}`);
    const text=(x,y,size,str,bold=false)=>{cmds.push(`BT /${bold?'F2':'F1'} ${size} Tf ${x} ${y} Td (${pdfEsc(str)}) Tj ET`)};
    // Premium background
    fill(0.97,0.93,0.84);rect(0,0,W,H);
    fill(0.10,0.025,0.16);rect(0,0,W,115);
    fill(0.55,0.08,0.18);rect(0,115,W,8);
    fill(1,0.82,0.34);rect(22,700,551,95);
    fill(0.18,0.04,0.22);rect(27,705,541,85);
    fill(1,0.83,0.39);text(43,758,23,'SAKTHI VEL CRACKERS',true);
    text(43,738,10,'FIREWORKS  |  PREMIUM QUALITY',true);
    text(43,720,9,'93442 65054  |  ALANGULAM Main Road, KUNDAYIRUPPU, SIVAKASI');
    fill(0.78,0.08,0.23);rect(390,728,150,42);
    fill(1,1,1);text(408,752,13,'ORDER BILL',true);text(413,737,9,pdfEsc(order.id));
    // customer block
    fill(0.18,0.04,0.22);rect(27,650,541,42);
    fill(1,0.83,0.39);text(40,675,10,'CUSTOMER DETAILS',true);
    fill(1,1,1);text(40,660,9,'Name: '+order.customer);text(210,660,9,'Mobile: '+order.phone);text(380,660,9,'Date: '+order.date);
    fill(0.99,0.98,0.94);rect(27,625,541,22);
    fill(0.15,0.05,0.18);text(40,633,8,'Delivery Address: '+order.address);
    // table
    const rows=order.items||[]; const maxRows=48; const shown=rows.slice(0,maxRows); const more=rows.length-shown.length;
    const top=605, bottom=145, rowH=Math.max(8,Math.min(17,(top-bottom)/(shown.length+2))); const fs=Math.max(5.5,Math.min(9,rowH*0.55));
    fill(0.62,0.04,0.20);rect(27,top-2,541,rowH+3);
    fill(1,1,1);text(40,top+2,fs,'S.No',true);text(72,top+2,fs,'PRODUCT',true);text(390,top+2,fs,'QTY',true);text(435,top+2,fs,'RATE',true);text(500,top+2,fs,'AMOUNT',true);
    let y=top-rowH-2;
    shown.forEach((it,i)=>{fill(i%2?1:0.96,i%2?0.98:0.94,i%2?0.95:0.88);rect(27,y-2,541,rowH+1);fill(0.12,0.04,0.15);text(40,y+2,fs,String(i+1));text(72,y+2,fs,it.name.slice(0,48));text(394,y+2,fs,String(it.qty));text(435,y+2,fs,money(it.price));text(500,y+2,fs,money(it.price*it.qty));y-=rowH;});
    if(more>0){fill(0.78,0.08,0.23);rect(27,y-2,541,rowH+2);fill(1,1,1);text(40,y+2,fs,'+ '+more+' more items',true);y-=rowH+2;}
    // total and footer
    fill(0.10,0.025,0.16);rect(27,105,541,38);fill(1,0.83,0.39);text(345,120,13,'TOTAL AMOUNT',true);text(485,120,15,money(order.total),true);
    fill(0.78,0.08,0.23);rect(27,60,541,34);fill(1,1,1);text(45,73,9,'Thank you for shopping with SAKTHI VEL CRACKERS!');text(397,73,8,'Please confirm your order on WhatsApp.');
    // Build PDF objects
    const stream=cmds.join('\n'); const objs=[];
    objs.push('<< /Type /Catalog /Pages 2 0 R >>');
    objs.push('<< /Type /Pages /Kids [3 0 R] /Count 1 >>');
    objs.push('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 5 0 R /F2 6 0 R >> >> /Contents 4 0 R >>');
    objs.push(`<< /Length ${stream.length} >>\\nstream\\n${stream}\\nendstream`);
    objs.push('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');
    objs.push('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>');
    let pdf='%PDF-1.4\n'; const offs=[0];
    objs.forEach((o,i)=>{offs.push(pdf.length);pdf+=(i+1)+' 0 obj\n'+o.replace(/\\n/g,'\n')+'\nendobj\n'});
    const xref=pdf.length;pdf+='xref\n0 '+(objs.length+1)+'\n0000000000 65535 f \n';for(let i=1;i<offs.length;i++)pdf+=String(offs[i]).padStart(10,'0')+' 00000 n \n';pdf+='trailer\n<< /Size '+(objs.length+1)+' /Root 1 0 R >>\nstartxref\n'+xref+'\n%%EOF';
    return new Blob([pdf],{type:'application/pdf'});
  }

  window.downloadBillPDF=function(order){
    const blob=makeBillPDF(order); const url=URL.createObjectURL(blob); const a=document.createElement('a');a.href=url;a.download='SAKTHI-VEL-'+order.id+'.pdf';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),5000);toast('✅ Premium Bill PDF downloaded',true);
  };
  window.shareBillWhatsApp=async function(order){
  // ONE fixed admin WhatsApp number for every customer order.
  const ADMIN_WA='919344265054';
  const message=[
    `🎆 ${data.brand} – NEW ORDER`,
    `━━━━━━━━━━━━━━━━`,
    `🧾 Order No: ${order.id}`,
    `👤 Customer: ${order.customer?.name || order.customer || 'Not provided'}`,
    `📞 Mobile: ${order.customer?.phone || order.phone || 'Not provided'}`,
    `📍 Address: ${order.customer?.address || order.address || 'Not provided'}`,
    ``,
    `🛍️ ORDER DETAILS`,
    ...order.items.map(x=>`${x.name} × ${x.qty} = ₹${x.qty*x.price}`),
    ``,
    `💰 TOTAL: ₹${order.total}`,
    `━━━━━━━━━━━━━━━━`,
    `Please confirm this order.`
  ].join('\n');
  // Use WhatsApp's direct-chat URL. No native share sheet and no contact selection.
  // The only destination is the business/admin number above.
  const whatsappUrl='https://wa.me/'+ADMIN_WA+'?text='+encodeURIComponent(message);
  window.location.href=whatsappUrl;
};
// Replace order confirmation with premium single-page PDF + WhatsApp file sharing.
  window.confirmBill=function(){
    const name=(document.getElementById('custName').value||'').trim(),phone=(document.getElementById('custPhone').value||'').trim(),address=(document.getElementById('custAddress').value||'').trim();
    if(!name||!phone||!address){alert('Name, Mobile Number, Address அனைத்தையும் நிரப்புங்கள்');return}
    if(!data.cart.length){alert('Cart is empty');return}
    const total=data.cart.reduce((a,x)=>a+x.price*x.qty,0),id='SK'+Date.now().toString().slice(-8),items=data.cart.map(x=>({...x}));
    const order={id,date:new Date().toLocaleDateString('en-IN'),customer:name,phone,address,items,total,status:'PENDING'};
    data.orders.push(order);data.cart=[];save();renderCart();closeModal();
    modal(`<button class="small close" onclick="closeModal()">✕</button><div style="background:linear-gradient(135deg,#160820,#6b0e2d,#b97920);padding:20px;border-radius:16px;color:#fff;box-shadow:0 15px 40px #0006"><div style="font-size:12px;letter-spacing:1px;color:#ffd274">🎆 PREMIUM ORDER BILL</div><h1 style="margin:6px 0">${data.brand}</h1><div>Order No: <b>${order.id}</b></div><div style="margin-top:10px">${order.customer} • ${order.phone}<br>${order.address}</div></div><div style="margin-top:12px;border:1px solid var(--line);border-radius:14px;overflow:hidden"><div style="background:#6e1028;padding:10px;font-weight:800">ORDER DETAILS</div>${items.map((x,i)=>`<div style="display:flex;justify-content:space-between;padding:9px 12px;border-bottom:1px solid var(--line)"><span>${i+1}. ${x.name} × ${x.qty}</span><b>₹${x.price*x.qty}</b></div>`).join('')}<div style="padding:14px;background:#21102b;text-align:right;font-size:22px;color:#ffd274"><b>TOTAL ₹${total}</b></div></div><div class="row" style="margin-top:14px"><button class="save" style="flex:1" onclick='shareBillWhatsApp(${JSON.stringify(order)})'>📲 Send Order to WhatsApp</button><button class="small" onclick='downloadBillPDF(${JSON.stringify(order)})'>⬇️ Download PDF</button></div><p style="font-size:12px;color:var(--muted);margin-top:10px">Order details நேரடியாக Admin WhatsApp எண்ணான 93442 65054-க்கு text message-ஆக செல்லும். PDF Bill-ஐ இங்கே Download செய்யலாம்.</p>`);
  };

  // Re-run category/product rendering after the overrides are installed.
  try{renderCats();renderProducts();renderCart()}catch(e){}
})();
</script>
<script>
/* FINAL CATEGORY FIX: category filter is kept separate from the search box. */
(function(){
  let activeCategory='ALL';
  const ALL='ALL';

  function ensureAllFirst(){
    if(!Array.isArray(data.categories)) data.categories=[];
    data.categories=data.categories.filter((c,i)=>String(c).trim().toUpperCase()!==ALL);
    data.categories.unshift(ALL);
    save();
  }

  function esc(s){return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\n/g,' ');}

  window.selectCategory=function(category){
    activeCategory=String(category||ALL);
    const search=document.getElementById('search');
    if(search) search.value='';
    document.querySelectorAll('#catGrid .cat').forEach(b=>{
      b.classList.toggle('selected', b.dataset.category===activeCategory);
    });
    renderProducts();
    setTimeout(()=>document.getElementById('products')?.scrollIntoView({behavior:'smooth',block:'start'}),20);
  };

  window.renderCats=function(){
    ensureAllFirst();
    const el=document.getElementById('catGrid'); if(!el)return;
    el.innerHTML=data.categories.map(c=>`<button type="button" class="cat ${String(c)===activeCategory?'selected':''}" data-category="${String(c).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}">${c}</button>`).join('');
    el.onclick=function(ev){
      const b=ev.target.closest('.cat');
      if(!b)return;
      selectCategory(b.dataset.category||ALL);
    };
  };

  window.renderProducts=function(){
    const search=((document.getElementById('search')?.value)||'').trim().toLowerCase();
    const cat=activeCategory||ALL;
    let p=(data.products||[]).filter(x=>x.enabled!==false);
    if(cat!==ALL) p=p.filter(x=>String(x.category||'').trim().toLowerCase()===cat.trim().toLowerCase());
    if(search) p=p.filter(x=>String(x.name||'').toLowerCase().includes(search)||String(x.category||'').toLowerCase().includes(search));
    const count=document.getElementById('productCount');
    if(count) count.textContent=' • '+p.length+' products • '+cat;
    const grid=document.getElementById('productGrid'); if(!grid)return;
    grid.innerHTML=p.map(x=>{
      const out=false;
      const stockText='Stock: Available';
      return `<div class="card">${typeof productPhoto==='function'?productPhoto(x):''}<h3>${x.name}</h3><p>${x.category}</p><div class="price">₹${x.price}</div><div style="font-weight:900;color:#7ff0a5;margin:7px 0">${stockText}</div><button class="add" onclick="addCart(${x.id})">ADD TO CART</button></div>`;
    }).join('')||'<p>No products found in this category.</p>';
  };

  /* Search from the header always searches inside the currently selected category. */
  window.categorySearch=function(){renderProducts();};
  const search=document.getElementById('search');
  if(search){search.oninput=categorySearch;}

  /* Keep ALL protected from deletion in Admin. */
  const oldDelete=window.deleteCategory;
  window.deleteCategory=function(i){
    const c=data.categories[i];
    if(String(c).toUpperCase()===ALL){toast('⚠️ ALL category cannot be deleted',false);return;}
    if(typeof oldDelete==='function') oldDelete(i);
  };

  /* Do not allow an Admin-created category named ALL; ALL is system-managed. */
  const oldAdd=window.addCategory;
  window.addCategory=function(){
    const input=document.getElementById('newCat');
    const c=(input?.value||'').trim().replace(/\s+/g,' ');
    if(c.toUpperCase()===ALL){toast('⚠️ ALL is already available',false);input?.focus();return;}
    if(typeof oldAdd==='function') oldAdd();
    ensureAllFirst(); renderCats();
  };

  /* If an Admin edits a product category, normalize the category to an existing name. */
  const oldSaveProduct=window.saveProduct;
  if(typeof oldSaveProduct==='function'){
    window.saveProduct=function(i){
      const sel=document.getElementById('pc');
      if(sel && String(sel.value).toUpperCase()===ALL){
        toast('⚠️ Product category cannot be ALL. Choose a real category.',false);return;
      }
      return oldSaveProduct(i);
    };
  }

  ensureAllFirst();
  renderCats();
  renderProducts();
})();
</script>

<script id="sakthivel-final-photo-arrow-fix">
(function(){
  // Never let the floating buttons cover product/cart controls.
  const css=document.createElement('style');
  css.textContent=`
    #whatsappFab,#topBtn{z-index:1000}
    #productGrid{padding-bottom:110px}
    .cartPanel{padding-bottom:110px}
    #whatsappFab,#topBtn{bottom:82px}
  `;
  document.head.appendChild(css);

  // Make the existing product photo loader update the customer cards as soon as photos are ready.
  if(window.renderProducts){
    const originalRender=window.renderProducts;
    window.renderProducts=function(){
      originalRender();
      // Replace any stored IndexedDB marker with the currently loaded object URL.
      document.querySelectorAll('#productGrid img[data-product-id]').forEach(img=>{
        const id=img.getAttribute('data-product-id');
        if(window.__sakthivelPhotoUrls && window.__sakthivelPhotoUrls[id]) img.src=window.__sakthivelPhotoUrls[id];
      });
    };
  }
  // Global, reliable top button handler (works even if browser's scrollTo binding differs).
  window.sakthivelGoTop=function(){
    try{window.scrollTo({top:0,left:0,behavior:'smooth'});}
    catch(e){document.documentElement.scrollTop=0;document.body.scrollTop=0;}
  };
  const top=document.getElementById('topBtn');
  if(top){top.onclick=window.sakthivelGoTop;}

  // Keep a public map for the photo loader.
  window.__sakthivelPhotoUrls=window.__sakthivelPhotoUrls||{};
})();
</script>
</body></html>
