<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07101f">
<title>SAKTHIVEL TRADERS | Premium Fireworks</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap');

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'DM Sans',sans-serif;
    background:#07101f;
    color:#172033;
}

/* =========================
   HERO
========================= */

.hero{
    min-height:620px;
    position:relative;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:
        radial-gradient(circle at 15% 20%,rgba(212,165,72,.20),transparent 28%),
        radial-gradient(circle at 85% 25%,rgba(92,43,121,.30),transparent 30%),
        radial-gradient(circle at 50% 100%,rgba(20,93,116,.22),transparent 35%),
        linear-gradient(135deg,#030712,#08172c 50%,#11091d);
}

.hero:before{
    content:"";
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at 20% 70%,#ffd76a 0 2px,transparent 3px),
        radial-gradient(circle at 80% 60%,#fff 0 2px,transparent 3px),
        radial-gradient(circle at 70% 20%,#ffd76a 0 2px,transparent 3px),
        radial-gradient(circle at 30% 30%,#fff 0 2px,transparent 3px);
    background-size:180px 180px,220px 220px,260px 260px,320px 320px;
    opacity:.35;
}

.hero-inner{
    width:min(1000px,92%);
    position:relative;
    z-index:2;
}

.hero-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:9px 17px;
    border:1px solid rgba(229,190,99,.35);
    border-radius:100px;
    color:#e9c46a;
    background:rgba(255,255,255,.04);
    font-size:12px;
    font-weight:800;
    letter-spacing:2px;
}

.brand{
    margin:25px 0 5px;
    font-family:'Playfair Display',serif;
    font-size:clamp(43px,8vw,88px);
    line-height:1;
    color:#fff;
    letter-spacing:-2px;
    text-shadow:0 15px 50px rgba(0,0,0,.5);
}

.hero-subtitle{
    color:#d7dee9;
    font-size:clamp(15px,2vw,20px);
    margin-top:18px;
}

.gold-line{
    width:90px;
    height:2px;
    margin:25px auto;
    background:linear-gradient(90deg,transparent,#e7bd65,transparent);
}

.hero-info{
    color:#aeb9c9;
    font-size:14px;
    line-height:1.9;
}

.hero-actions{
    margin-top:28px;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
}

.hero-btn{
    border:0;
    text-decoration:none;
    padding:14px 24px;
    border-radius:100px;
    font-weight:800;
    transition:.25s;
}

.hero-btn:hover{
    transform:translateY(-3px);
}

.btn-gold{
    background:linear-gradient(135deg,#f5d47c,#b98428);
    color:#07101f;
    box-shadow:0 10px 30px rgba(220,170,65,.18);
}

.btn-wa{
    background:#16a864;
    color:#fff;
}

/* =========================
   MAIN
========================= */

.main{
    background:#f5f7fa;
    min-height:500px;
}

.container{
    width:min(1220px,94%);
    margin:auto;
    padding:30px 0 100px;
}

/* TOP BAR */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    margin-bottom:20px;
}

.shop-title{
    font-family:'Playfair Display',serif;
    font-size:27px;
    color:#101a2c;
}

.shop-title span{
    color:#b27a20;
}

.cart-button{
    border:0;
    background:#07101f;
    color:#fff;
    border-radius:100px;
    padding:12px 18px;
    font-weight:800;
    cursor:pointer;
    position:relative;
}

.cart-count{
    position:absolute;
    right:-5px;
    top:-6px;
    width:23px;
    height:23px;
    display:flex;
    justify-content:center;
    align-items:center;
    border-radius:50%;
    background:#d7a743;
    color:#07101f;
    font-size:11px;
}

/* SEARCH */

.controls{
    display:grid;
    grid-template-columns:1fr 240px;
    gap:12px;
    margin-bottom:28px;
}

.search-box,
.category-select{
    background:#fff;
    border:1px solid #e0e5ec;
    border-radius:14px;
    padding:14px 16px;
    font-family:inherit;
    font-size:14px;
    outline:none;
}

.search-box:focus,
.category-select:focus{
    border-color:#c79b4d;
}

/* NOTICE */

.notice{
    background:#fff;
    border:1px solid #e5e9ef;
    border-radius:15px;
    padding:15px 18px;
    margin-bottom:28px;
    color:#596579;
    font-size:13px;
}

/* CATEGORY */

.category-title{
    display:flex;
    align-items:center;
    gap:12px;
    margin:35px 0 15px;
}

.category-title h2{
    font-family:'Playfair Display',serif;
    font-size:25px;
    color:#101a2c;
}

.category-count{
    background:#ead19b;
    color:#65420c;
    padding:5px 9px;
    border-radius:7px;
    font-size:10px;
    font-weight:900;
}

/* PRODUCTS */

.product-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.product{
    background:#fff;
    border:1px solid #e7ebf0;
    border-radius:18px;
    overflow:hidden;
    transition:.25s;
}

.product:hover{
    transform:translateY(-5px);
    box-shadow:0 18px 40px rgba(8,22,45,.10);
}

.product-image{
    height:190px;
    position:relative;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
        radial-gradient(circle at 50% 45%,rgba(255,213,102,.25),transparent 25%),
        linear-gradient(145deg,#0a1730,#182d50 55%,#39221b);
}

.product-image:after{
    content:"✦";
    position:absolute;
    font-size:100px;
    color:rgba(255,215,110,.13);
}

.firework-symbol{
    position:relative;
    z-index:2;
    font-size:67px;
    filter:drop-shadow(0 8px 15px rgba(0,0,0,.3));
}

.product-body{
    padding:15px;
}

.product-no{
    color:#8a94a4;
    font-size:10px;
    font-weight:800;
    letter-spacing:1px;
}

.product-name{
    color:#111b2c;
    font-weight:800;
    font-size:15px;
    min-height:40px;
    margin-top:5px;
}

.product-meta{
    color:#8a94a4;
    font-size:11px;
    margin-top:3px;
}

.product-bottom{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    margin-top:13px;
}

.price{
    color:#a66f16;
    font-size:19px;
    font-weight:900;
}

.add-btn{
    border:0;
    background:#07101f;
    color:#fff;
    padding:9px 12px;
    border-radius:9px;
    cursor:pointer;
    font-weight:800;
    font-size:11px;
}

.add-btn:hover{
    background:#b47e25;
}

/* =========================
   CART DRAWER
========================= */

.overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.55);
    z-index:90;
    display:none;
}

.overlay.show{
    display:block;
}

.cart-drawer{
    position:fixed;
    right:0;
    top:0;
    width:min(450px,94%);
    height:100vh;
    background:#fff;
    z-index:100;
    transform:translateX(105%);
    transition:.35s;
    display:flex;
    flex-direction:column;
}

.cart-drawer.open{
    transform:translateX(0);
}

.cart-header{
    padding:20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid #e7ebf0;
}

.cart-header h2{
    font-family:'Playfair Display',serif;
}

.close-cart{
    border:0;
    background:#f1f3f6;
    width:36px;
    height:36px;
    border-radius:50%;
    cursor:pointer;
    font-size:17px;
}

.cart-items{
    flex:1;
    overflow:auto;
    padding:15px 20px;
}

.cart-item{
    display:grid;
    grid-template-columns:1fr auto;
    gap:10px;
    padding:14px 0;
    border-bottom:1px solid #edf0f4;
}

.cart-item-name{
    font-weight:800;
    font-size:13px;
}

.cart-item-price{
    color:#a66f16;
    font-weight:800;
    font-size:12px;
    margin-top:4px;
}

.qty-controls{
    display:flex;
    align-items:center;
    gap:7px;
    margin-top:8px;
}

.qty-controls button{
    border:0;
    background:#edf0f4;
    width:26px;
    height:26px;
    border-radius:7px;
    cursor:pointer;
    font-weight:900;
}

.remove-item{
    color:#c44545;
    border:0;
    background:none;
    cursor:pointer;
    font-size:11px;
    margin-left:8px;
}

.cart-footer{
    border-top:1px solid #e7ebf0;
    padding:18px 20px;
}

.total-row{
    display:flex;
    justify-content:space-between;
    font-size:19px;
    font-weight:900;
    margin-bottom:15px;
}

.checkout-btn{
    width:100%;
    border:0;
    padding:14px;
    border-radius:12px;
    background:#16a864;
    color:#fff;
    font-weight:900;
    cursor:pointer;
}

/* =========================
   CHECKOUT MODAL
========================= */

.modal{
    position:fixed;
    inset:0;
    z-index:150;
    display:none;
    align-items:center;
    justify-content:center;
    padding:15px;
    background:rgba(2,7,16,.75);
}

.modal.show{
    display:flex;
}

.modal-box{
    background:#fff;
    width:min(600px,100%);
    max-height:92vh;
    overflow:auto;
    border-radius:22px;
    padding:25px;
}

.modal-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.modal-head h2{
    font-family:'Playfair Display',serif;
    font-size:27px;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.form-group{
    margin-bottom:12px;
}

.form-group.full{
    grid-column:1/-1;
}

.form-group label{
    display:block;
    font-size:11px;
    font-weight:800;
    color:#687386;
    margin-bottom:6px;
}

.form-group input,
.form-group textarea{
    width:100%;
    padding:12px 13px;
    border:1px solid #dce2ea;
    border-radius:10px;
    font-family:inherit;
    outline:none;
}

.form-group textarea{
    min-height:85px;
    resize:vertical;
}

.order-preview{
    background:#f5f7fa;
    padding:14px;
    border-radius:12px;
    margin:8px 0 15px;
    font-size:12px;
    line-height:1.8;
}

.send-order{
    width:100%;
    border:0;
    padding:15px;
    border-radius:12px;
    background:#16a864;
    color:#fff;
    font-weight:900;
    font-size:14px;
    cursor:pointer;
}

/* EMPTY */

.empty{
    padding:60px 20px;
    text-align:center;
    color:#7b8594;
}

/* FOOTER */

footer{
    background:#030811;
    color:#aeb8c8;
    padding:45px 20px;
    text-align:center;
}

.footer-brand{
    font-family:'Playfair Display',serif;
    font-size:27px;
    color:#e8c36d;
}

.footer-info{
    margin-top:12px;
    font-size:13px;
    line-height:1.9;
}

/* TOAST */

.toast{
    position:fixed;
    left:50%;
    bottom:25px;
    transform:translate(-50%,120px);
    background:#07101f;
    color:#fff;
    padding:12px 18px;
    border-radius:100px;
    font-size:12px;
    font-weight:800;
    z-index:300;
    transition:.3s;
}

.toast.show{
    transform:translate(-50%,0);
}

/* MOBILE */

@media(max-width:1000px){
    .product-grid{
        grid-template-columns:repeat(3,1fr);
    }
}

@media(max-width:700px){
    .hero{
        min-height:560px;
    }

    .product-grid{
        grid-template-columns:repeat(2,1fr);
        gap:10px;
    }

    .product-image{
        height:145px;
    }

    .firework-symbol{
        font-size:50px;
    }

    .controls{
        grid-template-columns:1fr;
    }

    .topbar{
        align-items:flex-start;
    }

    .shop-title{
        font-size:22px;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .form-group.full{
        grid-column:auto;
    }
}

@media(max-width:430px){
    .container{
        width:94%;
    }

    .product-body{
        padding:11px;
    }

    .product-name{
        font-size:13px;
    }

    .price{
        font-size:16px;
    }

    .add-btn{
        padding:8px 9px;
        font-size:10px;
    }

    .product-image{
        height:125px;
    }
}
</style>
</head>

<body>

<!-- ================= HERO ================= -->

<header class="hero">

<div class="hero-inner">

<div class="hero-badge">
🎆 PREMIUM FIREWORKS COLLECTION
</div>

<h1 class="brand">SAKTHIVEL<br>TRADERS</h1>

<div class="gold-line"></div>

<p class="hero-subtitle">
Premium Fireworks • Sivakasi
</p>

<div class="hero-info">
📍 Alangulam Main Road, Kundayiruppu, Sivakasi<br>
📞 <strong>93442 65054</strong>
</div>

<div class="hero-actions">
<a class="hero-btn btn-gold" href="#catalog">
🛍️ Explore Collection
</a>

<a class="hero-btn btn-wa"
href="https://wa.me/919344265054"
target="_blank">
💬 WhatsApp Us
</a>
</div>

</div>

</header>


<!-- ================= MAIN ================= -->

<main class="main">

<div class="container" id="catalog">

<div class="topbar">

<div class="shop-title">
SAKTHIVEL <span>TRADERS</span>
</div>

<button class="cart-button" onclick="openCart()">
🛒 My Cart
<span class="cart-count" id="cartCount">0</span>
</button>

</div>


<div class="controls">

<input
id="search"
class="search-box"
type="search"
placeholder="🔎 Search fireworks..."
oninput="render()">

<select id="category" class="category-select" onchange="render()">
<option value="">All Categories</option>
</select>

</div>


<div class="notice">
<strong>Premium Fireworks Collection</strong><br>
Select the products you need, choose quantities and place your complete order through WhatsApp. Availability and final billing will be confirmed by SAKTHIVEL TRADERS.
</div>


<div id="catalogContent"></div>

</div>

</main>


<!-- ================= CART ================= -->

<div class="overlay" id="overlay" onclick="closeCart()"></div>

<aside class="cart-drawer" id="cartDrawer">

<div class="cart-header">

<h2>Your Cart</h2>

<button class="close-cart" onclick="closeCart()">✕</button>

</div>

<div class="cart-items" id="cartItems"></div>

<div class="cart-footer">

<div class="total-row">
<span>Total</span>
<span id="cartTotal">₹0</span>
</div>

<button class="checkout-btn" onclick="openCheckout()">
CONTINUE TO CHECKOUT →
</button>

</div>

</aside>


<!-- ================= CHECKOUT ================= -->

<div class="modal" id="checkoutModal">

<div class="modal-box">

<div class="modal-head">

<h2>Place Your Order</h2>

<button class="close-cart" onclick="closeCheckout()">✕</button>

</div>

<form id="orderForm" onsubmit="sendOrder(event)">

<div class="form-grid">

<div class="form-group">
<label>CUSTOMER NAME *</label>
<input id="customerName" required placeholder="Your name">
</div>

<div class="form-group">
<label>MOBILE NUMBER *</label>
<input id="customerPhone"
type="tel"
required
pattern="[0-9]{10}"
placeholder="10 digit mobile number">
</div>

<div class="form-group full">
<label>FULL ADDRESS *</label>
<textarea id="customerAddress"
required
placeholder="House / Street / Area / Village"></textarea>
</div>

<div class="form-group">
<label>CITY / TOWN *</label>
<input id="customerCity" required placeholder="Sivakasi">
</div>

<div class="form-group">
<label>PINCODE *</label>
<input id="customerPincode"
required
pattern="[0-9]{6}"
placeholder="6 digit pincode">
</div>

<div class="form-group full">
<label>ADDITIONAL NOTE</label>
<textarea id="customerNote"
placeholder="Any special request..."></textarea>
</div>

</div>

<div class="order-preview" id="orderPreview"></div>

<button class="send-order" type="submit">
💬 SEND COMPLETE ORDER ON WHATSAPP
</button>

</form>

</div>

</div>


<!-- ================= FOOTER ================= -->

<footer>

<div class="footer-brand">
SAKTHIVEL TRADERS
</div>

<div class="footer-info">
🎆 Premium Fireworks Collection<br>
📞 93442 65054<br>
📍 Alangulam Main Road, Kundayiruppu, Sivakasi
<br><br>
<small>Product prices as supplied by the shop.</small>
</div>

</footer>


<div class="toast" id="toast">
Added to cart
</div>


<script>

/* =====================================================
   PRODUCT DATA
===================================================== */

const items = [
{"cat":"ONE SOUND CRACKERS","no":1,"name":"Gold Lakshmi","qty":"1 Pkt","rate":20},
