<style>
/* Online sync status - intentionally unobtrusive */
#onlineSyncStatus{position:fixed;bottom:8px;right:8px;z-index:99999;font:600 11px Arial;padding:5px 8px;border-radius:10px;background:#111;color:#fff;opacity:.75;pointer-events:none}
</style>
<script>
(function(){
  const KEY='sakthivel_online_sync_config';
  window.SAKTHI_SYNC={
    loadConfig:function(){
      try{return JSON.parse(localStorage.getItem(KEY)||'null')}catch(e){return null}
    },
    saveConfig:function(c){try{localStorage.setItem(KEY,JSON.stringify(c))}catch(e){}},
    isConfigured:function(){
      const c=this.loadConfig();
      return !!(c&&c.url&&c.anonKey&&c.table);
    },
    async pull(){
      const c=this.loadConfig();
      if(!c||!c.url||!c.anonKey||!c.table)return null;
      try{
        const u=c.url.replace(/\/+$/,'')+'/rest/v1/'+encodeURIComponent(c.table)+'?select=id,data&limit=1';
        const r=await fetch(u,{headers:{apikey:c.anonKey,Authorization:'Bearer '+c.anonKey}});
        if(!r.ok)throw new Error('sync '+r.status);
        const rows=await r.json();
        if(rows&&rows[0]&&rows[0].data){
          const remote=typeof rows[0].data==='string'?JSON.parse(rows[0].data):rows[0].data;
          localStorage.setItem('sakthivel_data',JSON.stringify(remote));
          return remote;
        }
      }catch(e){console.warn('Online sync pull failed',e)}
      return null;
    },
    async push(){
      const c=this.loadConfig();
      if(!c||!c.url||!c.anonKey||!c.table)return false;
      try{
        const d=localStorage.getItem('sakthivel_data');
        const u=c.url.replace(/\/+$/,'')+'/rest/v1/'+encodeURIComponent(c.table);
        const r=await fetch(u,{method:'POST',headers:{
          apikey:c.anonKey,Authorization:'Bearer '+c.anonKey,
          'Content-Type':'application/json',Prefer:'resolution=merge-duplicates'
        },body:JSON.stringify({id:1,data:d,updated_at:new Date().toISOString()})});
        return r.ok;
      }catch(e){console.warn('Online sync push failed',e);return false}
    },
    async refreshCustomer(){
      const d=await this.pull();
      if(d && typeof window.renderProducts==='function')window.renderProducts();
      return !!d;
    }
  };
  const oldSave=window.save;
  window.save=function(){
    const r=oldSave?oldSave.apply(this,arguments):undefined;
    if(window.SAKTHI_SYNC.isConfigured())window.SAKTHI_SYNC.push();
    return r;
  };
  document.addEventListener('DOMContentLoaded',function(){
    const el=document.createElement('div');el.id='onlineSyncStatus';el.textContent='Online sync ready';document.body.appendChild(el);
    if(window.SAKTHI_SYNC.isConfigured()){
      window.SAKTHI_SYNC.refreshCustomer();
      setInterval(()=>window.SAKTHI_SYNC.refreshCustomer(),5000);
    }
  });
})();
</script>

