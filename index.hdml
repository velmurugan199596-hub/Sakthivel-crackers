/* =====================================================
   CATEGORY
===================================================== */

const categories=[...new Set(items.map(x=>x.cat))];

const categorySelect=document.getElementById("category");

categories.forEach(cat=>{
    const option=document.createElement("option");
    option.value=cat;
    option.textContent=cat;
    categorySelect.appendChild(option);
});


/* =====================================================
   CART
===================================================== */

let cart=JSON.parse(localStorage.getItem("sakthivelCart")||"{}");


function saveCart(){
    localStorage.setItem("sakthivelCart",JSON.stringify(cart));
}


function addToCart(no){

    if(!cart[no]){
        cart[no]=1;
    }else{
        cart[no]++;
    }

    saveCart();
    updateCart();
    showToast("✓ Added to cart");
}


function changeQty(no,value){

    if(!cart[no]) return;

    cart[no]+=value;

    if(cart[no]<=0){
        delete cart[no];
    }

    saveCart();
    updateCart();
}


function removeItem(no){

    delete cart[no];

    saveCart();
    updateCart();
}


function cartQuantity(){

    return Object.values(cart)
        .reduce((sum,q)=>sum+q,0);
}


function cartTotal(){

    return Object.entries(cart)
        .reduce((sum,[no,q])=>{
            const item=items.find(x=>x.no==no);
            return sum+(item?item.rate*q:0);
        },0);
}


function updateCart(){

    document.getElementById("cartCount").textContent=cartQuantity();

    const root=document.getElementById("cartItems");

    const entries=Object.entries(cart);

    if(!entries.length){

        root.innerHTML=`
        <div class="empty">
            <div style="font-size:45px">🛒</div>
            <h3>Your cart is empty</h3>
            <p style="margin-top:8px">Add products to create your order.</p>
        </div>`;

    }else{

        root.innerHTML=entries.map(([no,q])=>{

            const item=items.find(x=>x.no==no);

            return `
            <div class="cart-item">

                <div>

                    <div class="cart-item-name">
                        ${item.name}
                    </div>

                    <div class="cart-item-price">
                        ₹${item.rate.toLocaleString("en-IN")}
                        × ${q}
                        = ₹${(item.rate*q).toLocaleString("en-IN")}
                    </div>

                    <div class="qty-controls">

                        <button onclick="changeQty(${no},-1)">−</button>

                        <strong>${q}</strong>

                        <button onclick="changeQty(${no},1)">+</button>

                        <button
                        class="remove-item"
                        onclick="removeItem(${no})">
                        Remove
                        </button>

                    </div>

                </div>

            </div>`;
        }).join("");
    }

    document.getElementById("cartTotal").textContent=
        "₹"+cartTotal().toLocaleString("en-IN");
}


/* =====================================================
   ICON
===================================================== */

function getIcon(cat,name){

    const n=name.toLowerCase();

    if(cat.includes("ROCKET")) return "🚀";

    if(cat.includes("SPARKLER")) return "✨";

    if(cat.includes("FLOWER") || n.includes("fountain"))
        return "🌸";

    if(cat.includes("BOMB"))
        return "💥";

    if(cat.includes("CHAKKAR"))
        return "🌀";

    if(cat.includes("GIFT"))
        return "🎁";

    if(cat.includes("MULTI SHOT") || n.includes("shot"))
        return "🎆";

    if(cat.includes("PENCIL"))
        return "🔥";

    if(cat.includes("PAPER"))
        return "💥";

    return "🎇";
}


/* =====================================================
   RENDER PRODUCTS
===================================================== */

function render(){

    const search=
        document.getElementById("search")
        .value
        .toLowerCase()
        .trim();

    const category=
        document.getElementById("category").value;

    const filtered=items.filter(item=>{

        const matchesSearch=
            !search ||
            item.name.toLowerCase().includes(search) ||
            item.cat.toLowerCase().includes(search);

        const matchesCategory=
            !category ||
            item.cat===category;

        return matchesSearch && matchesCategory;
    });


    const groups={};

    filtered.forEach(item=>{

        if(!groups[item.cat])
            groups[item.cat]=[];

        groups[item.cat].push(item);

    });


    const root=document.getElementById("catalogContent");


    if(!filtered.length){

        root.innerHTML=`
        <div class="empty">
            <div style="font-size:50px">🔎</div>
            <h2>No products found</h2>
            <p>Try another product name or category.</p>
        </div>`;

        return;
    }


    root.innerHTML=Object.entries(groups).map(([cat,arr])=>`

        <section>

            <div class="category-title">

                <h2>${cat}</h2>

                <span class="category-count">
                    ${arr.length} ITEMS
                </span>

            </div>


            <div class="product-grid">

                ${arr.map(item=>`

                    <article class="product">

                        <div class="product-image">

                            <div class="firework-symbol">
                                ${getIcon(item.cat,item.name)}
                            </div>

                        </div>


                        <div class="product-body">

                            <div class="product-no">
                                S.NO. ${item.no}
                            </div>

                            <div class="product-name">
                                ${item.name}
                            </div>

                            <div class="product-meta">
                                ${item.qty}
                            </div>


                            <div class="product-bottom">

                                <div class="price">
                                    ₹${item.rate.toLocaleString("en-IN")}
                                </div>

                                <button
                                class="add-btn"
                                onclick="addToCart(${item.no})">
                                + ADD
                                </button>

                            </div>

                        </div>

                    </article>

                `).join("")}

            </div>

        </section>

    `).join("");
}


/* =====================================================
   CART OPEN / CLOSE
===================================================== */

function openCart(){

    updateCart();

    document.getElementById("cartDrawer")
    .classList.add("open");

    document.getElementById("overlay")
    .classList.add("show");
}


function closeCart(){

    document.getElementById("cartDrawer")
    .classList.remove("open");

    document.getElementById("overlay")
    .classList.remove("show");
}


/* =====================================================
   CHECKOUT
===================================================== */

function openCheckout(){

    if(!Object.keys(cart).length){

        showToast("Please add products first");
        return;
    }

    closeCart();

    updateOrderPreview();

    document.getElementById("checkoutModal")
    .classList.add("show");
}


function closeCheckout(){

    document.getElementById("checkoutModal")
    .classList.remove("show");
}


function updateOrderPreview(){

    const preview=document.getElementById("orderPreview");

    const lines=Object.entries(cart).map(([no,q])=>{

        const item=items.find(x=>x.no==no);

        return `
        <div>
        <strong>${item.name}</strong>
        — ${q} × ₹${item.rate.toLocaleString("en-IN")}
        = ₹${(item.rate*q).toLocaleString("en-IN")}
        </div>`;
    }).join("");

    preview.innerHTML=`

        <strong>ORDER SUMMARY</strong>

        <div style="margin-top:8px">
        ${lines}
        </div>

        <hr style="margin:10px 0;border:0;border-top:1px solid #ddd">

        <strong>
        ${cartQuantity()} total quantity
        &nbsp; • &nbsp;
        Grand Total: ₹${cartTotal().toLocaleString("en-IN")}
        </strong>

    `;
}


/* =====================================================
   WHATSAPP ORDER
===================================================== */

function sendOrder(event){

    event.preventDefault();


    if(!Object.keys(cart).length){

        showToast("Cart is empty");
        return;
    }


    const name=
        document.getElementById("customerName")
        .value.trim();

    const phone=
        document.getElementById("customerPhone")
        .value.trim();

    const address=
        document.getElementById("customerAddress")
        .value.trim();

    const city=
        document.getElementById("customerCity")
        .value.trim();

    const pincode=
        document.getElementById("customerPincode")
        .value.trim();

    const note=
        document.getElementById("customerNote")
        .value.trim();


    let message=
`🎆 SAKTHIVEL TRADERS
NEW ONLINE ORDER

━━━━━━━━━━━━━━━━━━
CUSTOMER DETAILS
━━━━━━━━━━━━━━━━━━

👤 Name: ${name}
📞 Mobile: ${phone}
🏠 Address: ${address}
📍 City/Town: ${city}
📮 Pincode: ${pincode}

━━━━━━━━━━━━━━━━━━
ORDER DETAILS
━━━━━━━━━━━━━━━━━━
`;


    Object.entries(cart).forEach(([no,q],index)=>{

        const item=items.find(x=>x.no==no);

        message+=
`
${index+1}. ${item.name}
   Qty: ${q} ${item.qty.replace("1 ","")}
   Rate: ₹${item.rate.toLocaleString("en-IN")}
   Amount: ₹${(item.rate*q).toLocaleString("en-IN")}
`;
    });


    message+=
`
━━━━━━━━━━━━━━━━━━
TOTAL PRODUCTS: ${Object.keys(cart).length}
TOTAL QUANTITY: ${cartQuantity()}
GRAND TOTAL: ₹${cartTotal().toLocaleString("en-IN")}
━━━━━━━━━━━━━━━━━━
`;


    if(note){

        message+=
`
📝 Customer Note:
${note}

━━━━━━━━━━━━━━━━━━
`;
    }


    message+=
`
Please confirm my order.

Thank you,
SAKTHIVEL TRADERS`;



    const whatsappURL=
        "https://wa.me/919344265054?text="+
        encodeURIComponent(message);


    window.open(
        whatsappURL,
        "_blank"
    );


    closeCheckout();

    showToast("✓ Opening WhatsApp...");

}


/* =====================================================
   TOAST
===================================================== */

let toastTimer;

function showToast(text){

    const toast=document.getElementById("toast");

    toast.textContent=text;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer=setTimeout(()=>{

        toast.classList.remove("show");

    },2000);
}


/* =====================================================
   INITIALIZE
===================================================== */

render();

updateCart();

</script>

</body>
</html>
