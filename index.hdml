.adminTabs{display:flex;gap:8px;overflow:auto;margin-bottom:14px}.adminTabs button{white-space:nowrap;padding:9px;border-radius:10px;border:1px solid var(--line);background:#21142b;color:#fff}.adminItem{padding:12px;margin:8px 0;border:1px solid var(--line);border-radius:12px;background:#1b1223}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.small{padding:7px 9px;border-radius:9px;border:0;background:#382044;color:#fff}.danger{background:#6e1f2b}.on{background:#1d6b47}.off{background:#6e1f2b}

.priceListSection{margin:22px 0}.priceListCard{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:20px;border-radius:20px;background:linear-gradient(135deg,#24122d,#4b151e 55%,#17101f);border:1px solid rgba(255,210,116,.35);box-shadow:0 15px 35px rgba(0,0,0,.28)}.priceListCard h2{margin:5px 0;color:#fff;font-size:clamp(18px,4vw,28px)}.priceListCard p{margin:6px 0;color:var(--muted)}.priceListKicker{color:var(--gold);font-weight:900;font-size:12px;letter-spacing:1px}.priceBtn{white-space:nowrap;border:0;border-radius:12px;padding:12px 16px;background:linear-gradient(90deg,#d69d34,#ffcf6b);color:#24140c;font-weight:900}.pdfBox{background:#0d0812;border:1px solid var(--line);border-radius:14px;padding:14px;margin-top:12px}.pdfBox iframe{width:100%;height:60vh;border:0;border-radius:10px;background:#fff}
@media(max-width:600px){.grid{gap:8px}.card{padding:11px}.slide{padding:20px}.quick{justify-content:flex-start}.priceListCard{align-items:flex-start;flex-direction:column}.priceBtn{width:100%}}
